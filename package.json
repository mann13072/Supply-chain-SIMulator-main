{
  "name": "solarchain-twin-root",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "cd backend && python server.py || python3 server.py || py server.py",
    "dev:ui": "cd frontend && npm run dev",
    "install:frontend": "cd frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
